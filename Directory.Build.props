<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <SatelliteResourceLanguages>en;pl</SatelliteResourceLanguages>
    <Authors>4Kprojekt</Authors>
    <Product>Commander4K</Product>
    <!-- Local builds are 0.x.y-dev; release builds pass -p:Version from the git tag (see .github/workflows/release.yml).
         The SDK appends +<commit> to the informational version, which the app shows next to the version. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
    <Copyright>Copyright (c) 2026 4Kprojekt. MIT License.</Copyright>
    <RepositoryUrl>https://github.com/4kprojekt/Commander4K</RepositoryUrl>
  </PropertyGroup>
</Project>
