{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/4kprojekt/Commander4K/main/docs/plugin.schema.json",
  "title": "Commander4K plugin manifest (plugin.json)",
  "type": "object",
  "required": ["id", "name", "version", "author", "description", "runtime", "permissions", "contributes"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$", "description": "Unique id; the builtin. prefix is reserved." },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "description": "Semantic version, e.g. 1.0.0" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "protocol": { "type": "integer", "minimum": 1, "maximum": 1, "default": 1 },
    "runtime": {
      "type": "object",
      "required": ["type", "entry"],
      "properties": {
        "type": { "enum": ["python", "node", "powershell", "dotnet", "exe"] },
        "entry": { "type": "string", "description": "Start file inside the plugin folder." },
        "version": { "type": "string", "description": "Required range: >=3.10, >18 <25, ^7 or a bare 3.10 (meaning >=)." }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["fs.read", "fs.write", "process.read", "process.kill", "shell.run", "net", "system.info"] }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "category"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string", "description": "Menu path under Wtyczki; '/' makes a submenu." },
              "description": { "type": "string" },
              "shortcut": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "requiresArgument": { "type": "boolean", "description": "Opened for the file under the cursor (in the other panel)." },
              "refreshSeconds": { "type": "integer", "minimum": 1 },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "shortcut": { "type": "string" },
                    "confirm": { "type": "boolean" },
                    "appliesToRows": { "type": "boolean", "default": true }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "previews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "extensions"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "extensions": { "type": "array", "items": { "type": "string" }, "description": "An extension with the dot (\".csv\"), a file name (\"package.json\"), a pattern with * or ? (\"*.openapi.json\"), or \"/\" for folders." },
              "priority": { "type": "integer", "default": 10, "description": "Highest wins; built-ins: markdown 50, images 40, folders 10, text 0. Folder views meant only for c4k.dir use a negative value." },
              "card": { "type": "boolean", "default": false, "description": "The plugin answers preview.card, so c4k.dir dashboards can show this preview as a live card." },
              "webRoot": { "type": "string", "description": "Folder inside the plugin (relative, no ..) with the HTML/JS pages shown when preview.render returns kind \"web\". Required for that kind." },
              "suggest": {
                "type": "object",
                "description": "When the cursor rests on a folder that matches this rule, the app offers this preview as the folder's view (accepting writes c4k.dir). Checked by the app on the folder listing; the plugin is asked (preview.suggest) only with ask: true and only after the rule matched.",
                "properties": {
                  "files": { "type": "array", "items": { "type": "string" }, "description": "Patterns like extensions: \".jpg\", \"*.csv\", \"package.json\"." },
                  "minCount": { "type": "integer", "minimum": 1, "default": 1, "description": "At least this many matching files." },
                  "minShare": { "type": "number", "minimum": 0, "maximum": 1, "default": 0, "description": "Matching files among all files of the folder (folders not counted)." },
                  "contains": { "type": "array", "items": { "type": "string" }, "description": "Entries (files or folders) that must all exist, e.g. \".obsidian\"." },
                  "message": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Hint text per language code (\"pl\", \"en\"…); {count} = matching files. Default: the preview title." },
                  "ask": { "type": "boolean", "default": false, "description": "After the rule matched, ask the plugin with preview.suggest (it decides the score and message)." }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "palettes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "dock": { "enum": ["bottom", "left", "right", "between", "hidden"], "default": "bottom", "description": "Default position; the user can move it in the settings." },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "icon": { "type": "string", "description": "Short text or emoji shown on the button." },
                    "forItem": { "type": "boolean", "default": false, "description": "true = in each item's context menu; false = a button in the palette header." }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
