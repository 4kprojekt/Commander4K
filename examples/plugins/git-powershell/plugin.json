{
  "$schema": "https://raw.githubusercontent.com/4kprojekt/Commander4K/main/docs/plugin.schema.json",
  "id": "examples.git",
  "name": "Git (PowerShell)",
  "version": "1.0.1",
  "author": "4Kprojekt",
  "description": "Przykład: status i historia repozytorium Git w bieżącym folderze (uruchamia git przez aplikację).",
  "runtime": { "type": "powershell", "entry": "main.ps1", "version": ">=7.2" },
  "permissions": ["shell.run"],
  "contributes": {
    "commands": [
      { "id": "status", "title": "Git: status", "category": "Przykłady/Git", "description": "git status w bieżącym folderze." }
    ],
    "panels": [
      {
        "id": "log",
        "title": "Git: historia",
        "description": "Ostatnie 50 commitów bieżącego repozytorium.",
        "actions": [ { "id": "show", "title": "Pokaż zmiany", "shortcut": "Enter" } ]
      }
    ]
  }
}
