<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Commander4K.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Commander4K.PluginSdk\Commander4K.PluginSdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Commander4K.Core.Tests" />
  </ItemGroup>
  <!-- Built-in UI translations (Loc): Localization/i18n/<code>.json → resource "i18n/<code>.json". -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\i18n\*.json" LogicalName="i18n/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Fallback AI provider list; the live copy is read from the repository (AppSettings.AiCatalogUrl). -->
  <ItemGroup>
    <EmbeddedResource Include="Ai\ai-providers.json" LogicalName="ai-providers.json" />
  </ItemGroup>
  <!-- Fallback official plugin catalog; the live copy is read from the repository (AppSettings.PluginCatalogUrl). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\plugins-catalog\catalog.json" LogicalName="plugin-catalog.json" />
  </ItemGroup>
</Project>
