<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Commander4K.App</RootNamespace>
    <AssemblyName>Commander4K</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <!-- SkiaSharp/HarfBuzz packages ship ~100 MB of native .pdb symbols; keep them out of published builds. -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- The single-file bundler collects its own list (SDK-internal item name); filter it the same way. -->
  <Target Name="DropSymbolsFromBundle" AfterTargets="_ComputeFilesToBundle" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <_FilesToBundle Remove="@(_FilesToBundle)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- Example plugins ship inside the app as templates ("Nowa wtyczka z przykładu" in the plugin manager). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\examples\plugins\**\*" LogicalName="examples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Commander4K.PluginSdk\Commander4K.PluginSdk.csproj" />
    <ProjectReference Include="..\Commander4K.Core\Commander4K.Core.csproj" />
    <ProjectReference Include="..\Commander4K.Plugins.BuiltIn\Commander4K.Plugins.BuiltIn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Markup.Declarative" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Markdig" />
  </ItemGroup>
</Project>
