<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Commander4K.App</RootNamespace>
    <AssemblyName>Commander4K</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated (16–256 px, badge from 40 px); also embedded below for the window icons. -->
    <ApplicationIcon>Assets\commander4k.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- [LibraryImport] (browser key state) generates unsafe stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- SkiaSharp/HarfBuzz packages ship ~100 MB of native .pdb symbols and WebView2 an IntelliSense .xml (which would
       land next to the single-file exe); keep both out of published builds. -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
  <!-- The single-file bundler collects its own list (SDK-internal item name); filter it the same way. -->
  <Target Name="DropSymbolsFromBundle" AfterTargets="_ComputeFilesToBundle" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <_FilesToBundle Remove="@(_FilesToBundle)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
  <!-- Example plugins ship inside the app as templates ("Nowa wtyczka z przykładu" in the plugin manager). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\commander4k.ico" LogicalName="commander4k.ico" />
    <EmbeddedResource Include="..\..\examples\plugins\**\*" Exclude="..\..\examples\plugins\**\__pycache__\**;..\..\examples\plugins\pdf-viewer-node\**" LogicalName="examples/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The plugin guide given to AI assistants that write plugins (chat and browser panel). -->
    <EmbeddedResource Include="..\..\docs\plugins.md" LogicalName="docs/plugins.md" />
    <EmbeddedResource Include="..\..\docs\plugin.schema.json" LogicalName="docs/plugin.schema.json" />
    <!-- Offline Mermaid diagrams (Mermaid 12.2.0, MIT — LICENSE-mermaid.txt), extracted to data/mermaid on first use. -->
    <EmbeddedResource Include="Assets\Mermaid\render.html" LogicalName="mermaid/render.html" />
    <EmbeddedResource Include="Assets\Mermaid\mermaid.min.js" LogicalName="mermaid/mermaid.min.js" />
    <!-- The SSH terminal (xterm.js 6.0.0 + addon-fit 0.11.0, MIT — LICENSE-xterm.txt), extracted to data/xterm on first use. -->
    <EmbeddedResource Include="Assets\Xterm\terminal.html" LogicalName="xterm/terminal.html" />
    <EmbeddedResource Include="Assets\Xterm\xterm.js" LogicalName="xterm/xterm.js" />
    <EmbeddedResource Include="Assets\Xterm\xterm.css" LogicalName="xterm/xterm.css" />
    <EmbeddedResource Include="Assets\Xterm\addon-fit.js" LogicalName="xterm/addon-fit.js" />
    <!-- The .c4k editor (Monaco 0.52.2, MIT - Assets\Monaco\SOURCE.md), extracted to data/monaco on first use; the base schema it extends. -->
    <EmbeddedResource Include="Assets\Monaco\**/*" Exclude="Assets\Monaco\SOURCE.md" LogicalName="monaco/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/c4k.schema.json" LogicalName="docs/c4k.schema.json" />
    <!-- window.c4k, injected into web preview pages (Preview/WebPreviewView). -->
    <EmbeddedResource Include="Preview\WebBridge.js" LogicalName="preview/web-bridge.js" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Commander4K.PluginSdk\Commander4K.PluginSdk.csproj" />
    <ProjectReference Include="..\Commander4K.Core\Commander4K.Core.csproj" />
    <ProjectReference Include="..\Commander4K.Plugins.BuiltIn\Commander4K.Plugins.BuiltIn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Markup.Declarative" />
    <PackageReference Include="Markdig" />
    <!-- Only Microsoft.Web.WebView2.Core is used (hosted in a NativeControlHost). -->
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <!-- The WebView2 package's targets also reference its WinForms/WPF wrappers, whose WindowsBase 5.0 dependency
       conflicts with the shared framework (MSB3277, fatal with warnings-as-errors) and would bloat the bundle. -->
  <Target Name="DropWebView2UiWrappers" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
</Project>
