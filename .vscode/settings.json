{
  "dotnet.defaultSolution": "Commander4K.sln",
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "dist": true,
    "TestResults": true
  },
  "files.associations": {
    "plugin.json": "jsonc",
    "*.c4k": "jsonc"
  },
  "json.schemas": [
    { "fileMatch": ["**/plugins/*/plugin.json", "examples/plugins/*/plugin.json", "plugins-catalog/*/plugin.json"], "url": "./docs/plugin.schema.json" },
    { "fileMatch": ["*.c4k"], "url": "./docs/c4k.schema.json" }
  ]
}
